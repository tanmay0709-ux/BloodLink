# ============================================================
# BloodLink Backend — Environment Variables Template
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ============================================================

# MySQL credentials
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bloodlink_db
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# JWT — must be a Base64-encoded string of at least 32 random bytes (256 bits)
# Generate with: openssl rand -base64 32
JWT_SECRET=your_base64_encoded_jwt_secret_at_least_32_bytes_here
JWT_EXPIRATION=86400000

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173
